datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  password  String
  roleId String @db.ObjectId
  role      Role     @relation(fields: [roleId], references: [id])
  
  auditLogs AuditLog[]
}

model Role {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  permissions String[]
  users       User[]
}

model Restaurant {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  address  String
  logo     String?
  branches Branch[]
}

model Branch {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  restaurantId String @db.ObjectId
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  name         String
  tables       Table[]
}

model Table {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  branchId String @db.ObjectId
  branch   Branch  @relation(fields: [branchId], references: [id])
  name     String
  capacity Int
  status   String  @default("Available") // Available, Occupied, Reserved, Cleaning
  shape    String  @default("Round") // Round, Rectangle
  xPos     Float   @default(0)
  yPos     Float   @default(0)
  
  reservations Reservation[]
  qrCode       QRCode?
}

model MenuCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  items MenuItem[]
}

model MenuItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String @db.ObjectId
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  name       String
  price      Float
  gst        Float
  image      String?
  isVeg      Boolean      @default(true)
  prepTime   Int          @default(15) // In minutes
  addons     Json?
  
  recipe     Recipe?
}

model Customer {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  phone         String   @unique
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  walletBalance Float    @default(0)
  vip           Boolean  @default(false)
  createdAt     DateTime @default(now())

  orders         Order[]
  loyaltyAccount LoyaltyAccount?
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  customerId String? @db.ObjectId
  customer      Customer? @relation(fields: [customerId], references: [id])
  type          String   // Dine In, Take Away, Delivery
  status        String   @default("Pending") // Pending, Accepted, Preparing, Ready, Served, Completed, Cancelled
  total         Float
  tableNumber   String?
  waiterName    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
  kitchenOrders KitchenOrder[]
  payments      Payment[]
  invoice       Invoice?
  onlineOrder   OnlineOrder?
}

model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  menuItemId String @db.ObjectId
  name      String
  quantity  Int
  price     Float
  notes     String?
}

model KitchenOrder {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id])
  station   String   // Main Kitchen, Bar, Desserts
  status    String   @default("Pending") // Pending, Preparing, Ready, Completed
  createdAt DateTime @default(now())
}

model Ingredient {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  unit         String   // kg, g, l, ml, piece
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  maxStock     Float    @default(0)
  purchaseCost Float    @default(0)
  barcode      String?
  
  recipeItems  RecipeItem[]
  history      InventoryHistory[]
  purchaseItems PurchaseItem[]
}

model InventoryHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  ingredientId String @db.ObjectId
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  type         String     // IN, OUT, ADJUSTMENT, SALE_DEDUCTION
  quantity     Float
  reason       String?
  createdAt    DateTime   @default(now())
}

model Recipe {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  menuItemId String @db.ObjectId       @unique
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id])
  
  items      RecipeItem[]
}

model RecipeItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  recipeId String @db.ObjectId
  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredientId String @db.ObjectId
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float      // Amount of ingredient used
}

// ======================= PHASE 3 =======================

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  guestName       String
  phone           String
  email           String?
  date            DateTime
  time            String
  guestsCount     Int
  tableId String? @db.ObjectId
  table           Table?   @relation(fields: [tableId], references: [id])
  specialRequests String?
  isVIP           Boolean  @default(false)
  status          String   @default("Pending") // Pending, Confirmed, Cancelled, Completed
  advancePayment  Float    @default(0)
  createdAt       DateTime @default(now())
}

model Employee {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @db.ObjectId   @unique
  name            String
  department      String
  designation     String
  phone           String   @unique
  email           String?
  address         String?
  joiningDate     DateTime
  salary          Float
  shift           String
  status          String   @default("Active") // Active, Inactive, On Leave, Resigned
  createdAt       DateTime @default(now())

  attendance      Attendance[]
}

model Attendance {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @db.ObjectId
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  status      String   // Present, Absent, Half Day
}

model Supplier {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  companyName     String
  contactPerson   String
  phone           String   @unique
  email           String?
  gst             String?
  address         String?
  status          String   @default("Active")
  balance         Float    @default(0)
  purchases       Purchase[]
}

model Purchase {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  supplierId String @db.ObjectId
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  invoiceNumber   String   @unique
  purchaseDate    DateTime
  grandTotal      Float
  paymentStatus   String   @default("Pending") // Pending, Paid, Partial
  status          String   @default("Received") // Pending Approval, Received
  items           PurchaseItem[]
  createdAt       DateTime @default(now())
}

model PurchaseItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId String @db.ObjectId
  purchase        Purchase @relation(fields: [purchaseId], references: [id])
  ingredientId String @db.ObjectId
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  quantity        Float
  unitPrice       Float
  total           Float
}

model Expense {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  category        String   // Rent, Electricity, Water, Salary, etc.
  amount          Float
  vendor          String?
  paymentMode     String
  expenseDate     DateTime
  notes           String?
  isRecurring     Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ======================= PHASE 4 =======================

model Tax {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name        String   // CGST, SGST, IGST, Service Charge
  rate        Float
  type        String   // Percentage, Flat
  isActive    Boolean  @default(true)
}

model Discount {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String   // Percentage, Flat
  value       Float
  applyTo     String   // Bill, Category, Item
  isActive    Boolean  @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
}

model CashRegister {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @db.ObjectId
  openingTime DateTime @default(now())
  closingTime DateTime?
  openingCash Float
  closingCash Float?
  status      String   @default("Open") // Open, Closed
  payments    Payment[]
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order          Order        @relation(fields: [orderId], references: [id])
  cashRegisterId String @db.ObjectId
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  amount         Float
  method         String       // Cash, Card, UPI
  status         String       @default("Completed") // Completed, Refunded, Void
  createdAt      DateTime     @default(now())
}

model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  invoiceNo   String   @unique
  subTotal    Float
  taxTotal    Float
  discountTotal Float
  grandTotal  Float
  status      String   @default("Generated")
  createdAt   DateTime @default(now())
  
  items       InvoiceItem[]
}

model InvoiceItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String @db.ObjectId
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  name        String
  quantity    Int
  rate        Float
  amount      Float
}

model PrinterSetting {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String   // Receipt, KOT
  interface   String   // USB, LAN, Bluetooth
  paperWidth  String   // 58mm, 80mm
  isDefault   Boolean  @default(false)
}

// ======================= PHASE 5 =======================

model AnalyticsSnapshot {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime @unique
  revenue         Float
  ordersCount     Int
  customersCount  Int
  averageBill     Float
  profit          Float
  createdAt       DateTime @default(now())
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  category    String   // Orders, Inventory, System, Security
  priority    String   // Low, Medium, High
  isRead      Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model QRCode {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  tableId String @db.ObjectId   @unique
  table       Table    @relation(fields: [tableId], references: [id])
  token       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  scans       QRCodeScan[]
}

model QRCodeScan {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  qrCodeId String @db.ObjectId
  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id])
  deviceInfo  String?
  scannedAt   DateTime @default(now())
}

model SystemSetting {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique 
  value       String
  group       String   
  updatedAt   DateTime @updatedAt
}

model BranchSyncQueue {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  action      String   // INSERT, UPDATE, DELETE
  entity      String   // Order, Payment, Inventory
  payload     Json
  status      String   @default("Pending") // Pending, Synced, Failed
  createdAt   DateTime @default(now())
}

// ======================= PHASE 6 =======================

model LoyaltyAccount {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId      String   @unique @db.ObjectId
  customer        Customer @relation(fields: [customerId], references: [id])
  level           String   @default("Bronze") // Bronze, Silver, Gold, Platinum, Diamond
  points          Int      @default(0)
  walletBalance   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  transactions    RewardTransaction[]
}

model RewardTransaction {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  loyaltyAccountId String         @db.ObjectId
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
  type             String         // Earn, Redeem, Wallet_Recharge
  points           Int
  amount           Float
  description      String
  createdAt        DateTime       @default(now())
}

model OnlineOrder {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @unique @db.ObjectId
  order           Order    @relation(fields: [orderId], references: [id])
  type            String   // Delivery, Pickup
  deliveryAddress String?
  driverId        String?  @db.ObjectId
  driver          Driver?  @relation(fields: [driverId], references: [id])
  status          String   @default("Received") // Received, Preparing, Dispatched, Delivered
  deliveryCharge  Float    @default(0)
  createdAt       DateTime @default(now())
}

model Driver {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String   @unique
  vehicleInfo     String?
  status          String   @default("Offline") // Online, Offline, Busy
  onlineOrders    OnlineOrder[]
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // LOGIN, SETTINGS_CHANGE, DISCOUNT_OVERRIDE
  ipAddress   String?
  details     Json
  createdAt   DateTime @default(now())
}

model HardwareDevice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        String   // Printer, Scanner, Biometric, CashDrawer, Scale
  interface   String   // USB, Bluetooth, LAN, Serial
  status      String   @default("Disconnected")
  lastSeen    DateTime @default(now())
}

model BackupHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // Manual, Automatic
  fileName    String
  size        Int
  status      String   @default("Completed")
  createdAt   DateTime @default(now())
}

model AIPrediction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // SalesForecast, DemandForecast, PeakHours
  date        DateTime
  payload     Json
  confidence  Float
  createdAt   DateTime @default(now())
}
