{
  "name": "restaurant-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:restaurant\" \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:dress\"",
    "dev:test": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run dev:dress\"",
    "dev:restaurant": "npm run dev --workspace=apps/restaurant",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:admin": "npm run dev --workspace=apps/admin -- -p 3001",
    "dev:dress": "npm run dev --workspace=apps/dress -- -p 3002",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
